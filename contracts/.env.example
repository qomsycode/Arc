# ================================================
# Contracts Environment Variables (.env.example)
# ================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to GitHub.
# This .env is used by Hardhat during contract deployment.

# --- Deployer Wallet ---
# The private key of the wallet that will deploy the contracts to Arc L1
# WARNING: Use a dedicated deployer wallet — never your personal wallet.
DEPLOYER_PRIVATE_KEY=your-deployer-wallet-private-key-here

# --- Arc L1 Network ---
# RPC URL for Arc L1 (testnet or mainnet)
ARC_RPC_URL=https://rpc.arc.network

# Arc L1 Chain ID
ARC_CHAIN_ID=12345

# --- After Deployment ---
# Once deployed, paste the contract addresses here and also update frontend/.env and backend/.env
REWARD_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000
CHALLENGE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
