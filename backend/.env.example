# ================================================
# Backend Environment Variables (.env.example)
# ================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to GitHub.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Supabase ---
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Privy ---
# Get these from https://console.privy.io → Settings
PRIVY_APP_ID=your-privy-app-id-here
PRIVY_APP_SECRET=your-privy-app-secret-here

# --- Arc L1 Blockchain ---
# RPC URL for connecting to Arc L1
ARC_RPC_URL=https://rpc.arc.network

# Arc L1 Chain ID
ARC_CHAIN_ID=12345

# Platform treasury wallet private key (used to sign reward transactions)
# WARNING: Keep this extremely secret. Use a dedicated wallet — never your personal wallet.
PLATFORM_WALLET_PRIVATE_KEY=your-treasury-wallet-private-key-here

# --- Smart Contracts (deployed addresses — filled after deployment) ---
REWARD_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000
CHALLENGE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
