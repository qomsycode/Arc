# ================================================
# Frontend Environment Variables (.env.example)
# ================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to GitHub.

# --- Privy Auth ---
# Get this from https://console.privy.io after creating your app
VITE_PRIVY_APP_ID=your-privy-app-id-here

# --- Arc L1 Blockchain ---
# Arc L1 RPC URL (get from Arc team / documentation)
VITE_ARC_RPC_URL=https://rpc.arc.network

# Arc L1 Chain ID (confirm with Arc team)
VITE_ARC_CHAIN_ID=12345

# Arc L1 Block Explorer URL
VITE_ARC_EXPLORER_URL=https://explorer.arc.network

# --- Backend API ---
# URL of your Express backend server
VITE_BACKEND_URL=http://localhost:5000

# --- Smart Contracts (deployed addresses) ---
# These are filled in after contracts are deployed to Arc L1
VITE_REWARD_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHALLENGE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
