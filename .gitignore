# ===========================
# ARCademy — Root .gitignore
# ===========================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables (NEVER commit these)
.env
.env.local
.env.development
.env.production

# Build outputs
dist/
build/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
output.log

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
